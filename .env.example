# Copy this file to .env and fill in the values you actually use.
# Repo-local .env is checked first. A legacy host-specific fallback may also be
# read for compatibility, but the repo copy should be treated as the source of truth.

# Required for any Replicate-powered generation
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# Required if the agents invoke the pbc-os/brand-identity skill (Gemini-backed
# image generation via the nano-banana path). Leave unset to disable that skill
# cleanly; the rest of brand-gen runs without it.
GEMINI_API_KEY=

# Optional: choose a shared durable workspace root instead of repo-local .brand-gen
# BRAND_GEN_DIR=$HOME/.brand-gen

# Optional: local browser automation defaults
AGENT_BROWSER_SESSION=brand-gen
# Optional when multiple agent-browser installs exist
# AGENT_BROWSER_BIN=/full/path/to/agent-browser

# Optional: use remote Browserbase sessions instead of local Chromium
# AGENT_BROWSER_PROVIDER=browserbase
# BROWSERBASE_API_KEY=...
# BROWSERBASE_PROJECT_ID=...

# Optional: default workspace root for generated assets
# SCREENSHOTS_DIR=$HOME/brand-projects/acme
# LOGO_DIR=$HOME/brand-projects/acme/logo-redesigns   # legacy compatibility only

# Optional default output directory for generated brand materials
# BRAND_DIR=$HOME/brand-projects/acme/brand-materials

# Optional: agent/path wiring for local brand workflows
# BRAND_GEN_REPO_ROOT=$HOME/path/to/brand-gen
# LEGACY: BRAND_SOURCE_VAULT — prefer vault_paths in .brand-gen-local.json for Pi agents
# LEGACY: BRAND_STRATEGIC_REVIEW_VAULT — prefer vault_paths in .brand-gen-local.json
# BRAND_SOURCE_VAULT=$HOME/path/to/brand-vault
# BRAND_STRATEGIC_REVIEW_VAULT=$HOME/path/to/brand-strategic-reviews

# Optional: VLM provider for inspiration consolidation and visual critique
# Set ONE of these to enable VLM-powered inspiration analysis:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Recommended for the scoring subsystem (DSPy scorer + v2 GEPA optimization).
# Default routes through OpenRouter (one key, many models) instead of
# separate per-provider keys. Override via BRAND_GEN_SCORER_MODEL.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Optional override: explicit LiteLLM model string for the scoring judge.
# Examples:
#   openrouter/anthropic/claude-sonnet-4.5   (default)
#   openrouter/openai/gpt-4.1                (swap provider, same key)
#   openrouter/google/gemini-2.5-pro         (same key)
#   anthropic/claude-sonnet-4-5-20250929     (direct Anthropic, needs ANTHROPIC_API_KEY)
# BRAND_GEN_SCORER_MODEL=openrouter/anthropic/claude-sonnet-4.5
