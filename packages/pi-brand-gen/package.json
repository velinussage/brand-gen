{
  "name": "@brand-gen/pi-extension",
  "version": "0.1.0",
  "description": "Pi extension for brand-gen with heartbeat, widget, commands, and MCP bridge",
  "type": "module",
  "main": "./dist/index.js",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test ./test/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@brand-gen/core": "file:../brand-gen-core",
    "@mariozechner/pi-ai": "latest",
    "@mariozechner/pi-tui": "latest",
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "types": "./dist/index.d.ts"
}
