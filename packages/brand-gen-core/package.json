{
  "name": "@brand-gen/core",
  "version": "0.1.0",
  "description": "Shared data layer for brand-gen: MCP bridge, SQLite journal, learnings, heartbeat cycle, generation policy",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test ./test/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "types": "./dist/index.d.ts"
}
