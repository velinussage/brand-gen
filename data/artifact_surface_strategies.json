  "strategies": {
    "editorial_poster": {
      "label": "Editorial poster",
      "summary": "Lead with one dominant headline, keep proof subordinate, and make the page read like a designed portrait poster rather than a dashboard tile.",
      "layout_family": "poster",
      "composition_modes": [
        "statement_poster",
        "artifact_monolith",
        "prompt_sheet",
        "reference_sheet"
      ],
      "asset_slots": [
        "logo_block",
        "qr_block",
        "brand_motif"
      ],
      "prompt_directive": "Use a poster-first composition with a dominant headline, strong vertical rhythm, and a compact subordinate proof module.",
      "best_for_material_types": [
        "announcement-card"
      ],
      "best_for_entity_types": [
        "prompt",
        "skill",
        "library",
        "proposal",
        "community",
        "dao",
        "update"
      ],
      "preferred_source_shapes": [
        "governed_text",
        "source_resolved_text"
      ],
      "supports_exact_text": true,
      "experimental_range": [
        4,
        10
      ]
    },
    "compact_proof_card": {
      "label": "Compact proof card",
      "summary": "Keep the card feed-speed readable with a concise headline and a tight proof module anchored by a few high-signal details.",
      "layout_family": "proof_card",
      "composition_modes": [
        "excerpt_sheet",
        "split_editorial",
        "detail_matrix",
        "reference_sheet"
      ],
      "asset_slots": [
        "logo_block",
        "qr_block",
        "brand_motif"
      ],
      "prompt_directive": "Prioritize fast scanning, concise hierarchy, and one compact proof module with strong semantic curation.",
      "best_for_material_types": [
        "social",
        "x-feed",
        "announcement-card"
      ],
      "best_for_entity_types": [
        "prompt",
        "skill",
        "library",
        "proposal",
        "update"
      ],
      "preferred_source_shapes": [
        "governed_text",
        "source_resolved_text",
        "product_detail"
      ],
      "supports_exact_text": true,
      "experimental_range": [
        1,
        8
      ]
    },
    "capability_card": {
      "label": "Capability card",
      "summary": "Frame the artifact as a reusable capability with outcome-led copy, clustered signals, and less document-like presentation.",
      "layout_family": "capability",
      "composition_modes": [
        "split_editorial",
        "utility_sidebar",
        "detail_matrix"
      ],
      "asset_slots": [
        "logo_block",
        "brand_motif",
        "accent_rule"
      ],
      "prompt_directive": "Present the artifact as a reusable capability. Emphasize outcomes, repeatable value, and recognizable capability framing over document chrome.",
      "best_for_material_types": [
        "social",
        "x-feed"
      ],
      "best_for_entity_types": [
        "skill",
        "prompt"
      ],
      "preferred_source_shapes": [
        "governed_text",
        "source_resolved_text"
      ],
      "supports_exact_text": false,
      "experimental_range": [
        3,
        9
      ]
    },
    "collection_card": {
      "label": "Collection card",
      "summary": "Show the artifact as part of a governed collection with breadth, curation, and recognizable library context.",
      "layout_family": "collection",
      "composition_modes": [
        "utility_sidebar",
        "reference_sheet",
        "detail_matrix"
      ],
      "asset_slots": [
        "logo_block",
        "brand_motif",
        "accent_rule"
      ],
      "prompt_directive": "Emphasize curation, collection breadth, and governed distribution. Use the proof module to signal scope rather than isolated document detail.",
      "best_for_material_types": [
        "x-feed",
        "social"
      ],
      "best_for_entity_types": [
        "library"
      ],
      "preferred_source_shapes": [
        "governed_text",
        "source_resolved_text"
      ],
      "supports_exact_text": false,
      "experimental_range": [
        2,
        8
      ]
    },
    "governance_snapshot": {
      "label": "Governance snapshot",
      "summary": "Lead with the governed outcome or artifact status, then support it with compact provenance and participation context.",
      "layout_family": "governance",
      "composition_modes": [
        "utility_sidebar",
        "detail_matrix",
        "excerpt_sheet"
      ],
      "asset_slots": [
        "logo_block",
        "brand_motif",
        "accent_rule"
      ],
      "prompt_directive": "Frame the card as a governance-aware snapshot. Lead with the artifact or outcome first, and keep mechanics compact and subordinate.",
      "best_for_material_types": [
        "x-feed",
        "social"
      ],
      "best_for_entity_types": [
        "proposal",
        "community",
        "dao",
        "library"
      ],
      "preferred_source_shapes": [
        "governed_text",
        "governance_record"
      ],
      "supports_exact_text": false,
      "experimental_range": [
        2,
        7
      ]
    },
    "qr_spotlight": {
      "label": "QR spotlight",
      "summary": "Use the QR as an intentional scan affordance, but only when the destination itself is the core interaction.",
      "layout_family": "scan_forward",
      "composition_modes": [
        "scan_card",
        "reference_sheet",
        "utility_sidebar"
      ],
      "asset_slots": [
        "logo_block",
        "qr_block",
        "brand_motif"
      ],
      "prompt_directive": "Treat the QR as a designed affordance for scanning, not as the primary hero. It should support the composition, not overwhelm the message.",
      "best_for_material_types": [
        "announcement-card",
        "social"
      ],
      "best_for_entity_types": [
        "prompt",
        "skill",
        "library"
      ],
      "preferred_source_shapes": [
        "governed_text",
        "source_resolved_text"
      ],
      "supports_exact_text": true,
      "experimental_range": [
        5,
        10
      ]
    },
    "operator_proof_board": {
      "label": "Operator proof board",
      "summary": "Use a landscape board for workflow/product-truth-sensitive proof: concise title on the left, deterministic five-step proof module on the right, with a small source QR only when a real source URL exists.",
      "layout_family": "operator_workflow",
      "composition_modes": [
        "operator_workflow",
        "detail_matrix",
        "split_editorial"
      ],
      "asset_slots": [
        "logo_block",
        "qr_block",
        "brand_motif",
        "accent_rule"
      ],
      "prompt_directive": "For workflow proof, choose a landscape operator board: concise headline, one large deterministic proof module, five readable step tiles, and no footer chrome. Include a small QR/source affordance only when a real source URL is supplied; never invent QR/private-access chrome.",
      "best_for_material_types": [
        "proof-poster"
      ],
      "best_for_entity_types": [
        "skill",
        "prompt",
        "library",
        "update"
      ],
      "preferred_source_shapes": [
        "product_detail",
        "source_resolved_text",
        "governed_text",
        "generic"
      ],
      "supports_exact_text": true,
      "experimental_range": [
        1,
        10
      ]
    }
